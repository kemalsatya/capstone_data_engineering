<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_05_opencellid</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_05_opencellid</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_05_opencellid
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_05_opencellid r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN LOWER(TRIM(r."radio")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."radio") END) AS "radio",
  (CASE WHEN LOWER(TRIM(r."mcc")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."mcc") END) AS "mcc",
  (CASE WHEN LOWER(TRIM(r."net")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."net") END) AS "net",
  (CASE WHEN LOWER(TRIM(r."area")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."area") END) AS "area",
  (CASE WHEN LOWER(TRIM(r."cell")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."cell") END) AS "cell",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."unit")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."unit") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."unit")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."unit") END)::numeric)::integer ELSE NULL END) AS "unit",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."lon")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lon") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."lon")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lon") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."lon")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lon") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."lon")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lon") END), ',', '.')::numeric ELSE NULL END) AS "lon",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."lat")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lat") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."lat")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lat") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."lat")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lat") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."lat")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."lat") END), ',', '.')::numeric ELSE NULL END) AS "lat",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."range")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."range") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."range")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."range") END)::numeric)::integer ELSE NULL END) AS "range",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."samples")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."samples") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."samples")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."samples") END)::numeric)::integer ELSE NULL END) AS "samples",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."changeable")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."changeable") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."changeable")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."changeable") END)::numeric)::integer ELSE NULL END) AS "changeable",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."created")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."created") END) ~ '^[0-9]+(?:\.0+)?$' THEN TO_TIMESTAMP(TRUNC((CASE WHEN LOWER(TRIM(r."created")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."created") END)::numeric)) ELSE NULL END) AS "created",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."updated")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."updated") END) ~ '^[0-9]+(?:\.0+)?$' THEN TO_TIMESTAMP(TRUNC((CASE WHEN LOWER(TRIM(r."updated")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."updated") END)::numeric)) ELSE NULL END) AS "updated",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."averagesignal")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."averagesignal") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."averagesignal")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."averagesignal") END)::numeric)::integer ELSE NULL END) AS "averagesignal"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "radio",
  "mcc",
  "net",
  "area",
  "cell",
  "unit",
  "lon",
  "lat",
  "range",
  "samples",
  "changeable",
  "created",
  "updated",
  "averagesignal",
  CASE WHEN (radio IS NULL OR cell IS NULL) OR (lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (radio IS NULL OR cell IS NULL) OR (lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5) OR (range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN radio IS NULL OR cell IS NULL THEN 'DQ-KEY-07'
    WHEN lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5 THEN 'DQ-GEO-01-LAND'
    WHEN range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1 THEN 'DQ-DOM-07'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN radio IS NULL OR cell IS NULL THEN 'CRITICAL'
    WHEN lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5 THEN 'CRITICAL'
    WHEN range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1 THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN radio IS NULL OR cell IS NULL THEN 'radio,cell'
    WHEN lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5 THEN 'lat,lon'
    WHEN range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1 THEN 'range,samples'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN radio IS NULL OR cell IS NULL THEN (COALESCE(radio,'NULL') || '|' || COALESCE(cell,'NULL'))::text
    WHEN lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5 THEN (COALESCE(lat::text,'NULL') || ',' || COALESCE(lon::text,'NULL'))::text
    WHEN range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1 THEN (COALESCE(range::text,'NULL') || ',' || COALESCE(samples::text,'NULL'))::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN radio IS NULL OR cell IS NULL THEN 'Kunci radio atau cell kosong'
    WHEN lat IS NULL OR lon IS NULL OR lat NOT BETWEEN -11.5 AND 6.5 OR lon NOT BETWEEN 94.5 AND 141.5 THEN 'Koordinat menara seluler di luar BBox daratan Indonesia'
    WHEN range IS NULL OR range &lt;= 0 OR samples IS NULL OR samples &lt; 1 THEN 'Radius cakupan &lt;= 0 atau samples &lt; 1'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(radio,'') || '|' || COALESCE(net,'') || '|' || COALESCE(area,'') || '|' || COALESCE(cell,''))::text AS dq_record_id,
  'raw.src_05_opencellid'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Filter DQ Issues</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Log DQ Issues</send_true_to>
    <send_false_to>No DQ Issue</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_has_issue</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform>
