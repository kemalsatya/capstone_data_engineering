<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_01_bmkg_gempa</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_01_bmkg_gempa</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_01_bmkg_gempa
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_01_bmkg_gempa r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."no")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."no") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."no")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."no") END)::numeric)::integer ELSE NULL END) AS "no",
  (CASE WHEN LOWER(TRIM(r."event_id")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."event_id") END) AS "event_id",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) ~ '^[0-9]{1,2}-[A-Za-z]{3}-[0-9]{4}$' THEN TO_DATE((CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END), 'DD-Mon-YYYY') WHEN (CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN SUBSTRING((CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) FROM 1 FOR 10)::date ELSE NULL END) AS "date",
  (CASE WHEN LOWER(TRIM(r."time_utc")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."time_utc") END) AS "time_utc",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."latitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."latitude") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."latitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."latitude") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."latitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."latitude") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."latitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."latitude") END), ',', '.')::numeric ELSE NULL END) AS "latitude",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."longitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."longitude") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."longitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."longitude") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."longitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."longitude") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."longitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."longitude") END), ',', '.')::numeric ELSE NULL END) AS "longitude",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."magnitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."magnitude") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."magnitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."magnitude") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."magnitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."magnitude") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."magnitude")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."magnitude") END), ',', '.')::numeric ELSE NULL END) AS "magnitude",
  (CASE WHEN LOWER(TRIM(r."mag_type")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."mag_type") END) AS "mag_type",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."depth_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."depth_km") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."depth_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."depth_km") END)::numeric)::integer ELSE NULL END) AS "depth_km",
  (CASE WHEN LOWER(TRIM(r."source")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."source") END) AS "source",
  (CASE WHEN LOWER(TRIM(r."source_event_id")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."source_event_id") END) AS "source_event_id"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "no",
  "event_id",
  "date",
  "time_utc",
  "latitude",
  "longitude",
  "magnitude",
  "mag_type",
  "depth_km",
  "source",
  "source_event_id",
  CASE WHEN (event_id IS NULL) OR (latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5) OR (magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (event_id IS NULL) OR (latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5) OR (magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10) OR (depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN event_id IS NULL THEN 'DQ-KEY-01'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5 THEN 'DQ-GEO-01-EQ'
    WHEN magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10 THEN 'DQ-DOM-01'
    WHEN depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800 THEN 'DQ-DOM-02'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN event_id IS NULL THEN 'CRITICAL'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5 THEN 'CRITICAL'
    WHEN magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10 THEN 'CRITICAL'
    WHEN depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800 THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN event_id IS NULL THEN 'event_id'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5 THEN 'latitude,longitude'
    WHEN magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10 THEN 'magnitude'
    WHEN depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800 THEN 'depth_km'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN event_id IS NULL THEN (event_id)::text
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5 THEN (COALESCE(latitude::text,'NULL') || ',' || COALESCE(longitude::text,'NULL'))::text
    WHEN magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10 THEN (magnitude::text)::text
    WHEN depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800 THEN (depth_km::text)::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN event_id IS NULL THEN 'Event ID kosong/null'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -15.5 AND 7.5 OR longitude NOT BETWEEN 93.5 AND 142.5 THEN 'Koordinat gempa di luar BBox seismik Indonesia [-15.5..7.5, 93.5..142.5]'
    WHEN magnitude IS NULL OR magnitude &lt;= 0 OR magnitude &gt; 10 THEN 'Magnitudo di luar rentang valid (0, 10]'
    WHEN depth_km IS NULL OR depth_km &lt; 0 OR depth_km &gt; 800 THEN 'Kedalaman hiposenter di luar rentang wajar [0, 800] km'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(event_id, _src_file || '#' || _row_no))::text AS dq_record_id,
  'raw.src_01_bmkg_gempa'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Filter DQ Issues</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Log DQ Issues</send_true_to>
    <send_false_to>No DQ Issue</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_has_issue</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>300</yloc></GUI>
  </transform>
