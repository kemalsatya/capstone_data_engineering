<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_03_iklim_harian</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_03_iklim_harian</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_03_iklim_harian
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_03_iklim_harian r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) ~ '^[0-9]{1,2}-[0-9]{1,2}-[0-9]{4}$' THEN TO_DATE((CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END), 'DD-MM-YYYY') WHEN (CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN SUBSTRING((CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) FROM 1 FOR 10)::date ELSE NULL END) AS "date",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."tn")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tn") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."tn")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tn") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."tn")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tn") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."tn")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tn") END), ',', '.')::numeric ELSE NULL END) AS "tn",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."tx")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tx") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."tx")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tx") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."tx")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tx") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."tx")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tx") END), ',', '.')::numeric ELSE NULL END) AS "tx",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."tavg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tavg") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."tavg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tavg") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."tavg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tavg") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."tavg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tavg") END), ',', '.')::numeric ELSE NULL END) AS "tavg",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."rh_avg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rh_avg") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."rh_avg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rh_avg") END)::numeric)::integer ELSE NULL END) AS "rh_avg",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."rr")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rr") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."rr")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rr") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."rr")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rr") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."rr")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rr") END), ',', '.')::numeric ELSE NULL END) AS "rr",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."ss")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ss") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."ss")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ss") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."ss")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ss") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."ss")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ss") END), ',', '.')::numeric ELSE NULL END) AS "ss",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."ff_x")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ff_x") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."ff_x")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ff_x") END)::numeric)::integer ELSE NULL END) AS "ff_x",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."ddd_x")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ddd_x") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."ddd_x")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ddd_x") END)::numeric)::integer ELSE NULL END) AS "ddd_x",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."ff_avg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ff_avg") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."ff_avg")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ff_avg") END)::numeric)::integer ELSE NULL END) AS "ff_avg",
  (CASE WHEN LOWER(TRIM(r."ddd_car")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."ddd_car") END) AS "ddd_car",
  (CASE WHEN LOWER(TRIM(r."station_id")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."station_id") END) AS "station_id"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "date",
  CASE WHEN (tn NOT BETWEEN 0 AND 45) THEN NULL ELSE "tn" END AS "tn",
  CASE WHEN (tx NOT BETWEEN 0 AND 45) THEN NULL ELSE "tx" END AS "tx",
  CASE WHEN (tavg NOT BETWEEN 0 AND 45) THEN NULL ELSE "tavg" END AS "tavg",
  CASE WHEN (rh_avg NOT BETWEEN 0 AND 100) THEN NULL ELSE "rh_avg" END AS "rh_avg",
  CASE WHEN (rr NOT BETWEEN 0 AND 500) THEN NULL ELSE "rr" END AS "rr",
  CASE WHEN (ss NOT BETWEEN 0 AND 24) THEN NULL ELSE "ss" END AS "ss",
  CASE WHEN (ff_x NOT BETWEEN 0 AND 60) THEN NULL ELSE "ff_x" END AS "ff_x",
  CASE WHEN (ddd_x NOT BETWEEN 0 AND 360) THEN NULL ELSE "ddd_x" END AS "ddd_x",
  CASE WHEN (ff_avg NOT BETWEEN 0 AND 60) THEN NULL ELSE "ff_avg" END AS "ff_avg",
  "ddd_car",
  "station_id",
  CASE WHEN (station_id IS NULL OR date IS NULL) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (station_id IS NULL OR date IS NULL) OR ((tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360)) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN station_id IS NULL OR date IS NULL THEN 'DQ-KEY-03'
    WHEN (tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360) THEN 'DQ-DOM-05'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN station_id IS NULL OR date IS NULL THEN 'CRITICAL'
    WHEN (tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360) THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN station_id IS NULL OR date IS NULL THEN 'station_id,date'
    WHEN (tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360) THEN 'tn,tx,tavg,rh_avg,rr,ss,ff_x,ff_avg,ddd_x'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN station_id IS NULL OR date IS NULL THEN (COALESCE(station_id,'NULL') || '|' || COALESCE(date::text,'NULL'))::text
    WHEN (tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360) THEN (CONCAT_WS(',', 'Tx=' || tx::text, 'RR=' || rr::text, 'RH=' || rh_avg::text))::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN station_id IS NULL OR date IS NULL THEN 'station_id atau tanggal pengamatan kosong'
    WHEN (tn IS NOT NULL AND tn NOT BETWEEN 0 AND 45) OR (tx IS NOT NULL AND tx NOT BETWEEN 0 AND 45) OR (tavg IS NOT NULL AND tavg NOT BETWEEN 0 AND 45) OR (rh_avg IS NOT NULL AND rh_avg NOT BETWEEN 0 AND 100) OR (rr IS NOT NULL AND rr NOT BETWEEN 0 AND 500) OR (ss IS NOT NULL AND ss NOT BETWEEN 0 AND 24) OR (ff_x IS NOT NULL AND ff_x NOT BETWEEN 0 AND 60) OR (ff_avg IS NOT NULL AND ff_avg NOT BETWEEN 0 AND 60) OR (ddd_x IS NOT NULL AND ddd_x NOT BETWEEN 0 AND 360) THEN 'Nilai sensor iklim di luar batas wajar (kolom anomali dinullkan di staging)'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(station_id, 'NULL') || '|' || COALESCE(date::text, _row_no::text))::text AS dq_record_id,
  'raw.src_03_iklim_harian'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
