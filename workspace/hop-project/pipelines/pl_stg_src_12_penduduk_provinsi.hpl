<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_12_penduduk_provinsi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_12_penduduk_provinsi</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_12_penduduk_provinsi
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_12_penduduk_provinsi r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN LOWER(TRIM(r."provinsi")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."provinsi") END) AS "provinsi",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."jumlah_penduduk_ribu")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."jumlah_penduduk_ribu") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."jumlah_penduduk_ribu")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."jumlah_penduduk_ribu") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."jumlah_penduduk_ribu")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."jumlah_penduduk_ribu") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."jumlah_penduduk_ribu")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."jumlah_penduduk_ribu") END), ',', '.')::numeric ELSE NULL END) AS "jumlah_penduduk_ribu",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."laju_pertumbuhan_penduduk_per_tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."laju_pertumbuhan_penduduk_per_tahun") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."laju_pertumbuhan_penduduk_per_tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."laju_pertumbuhan_penduduk_per_tahun") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."laju_pertumbuhan_penduduk_per_tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."laju_pertumbuhan_penduduk_per_tahun") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."laju_pertumbuhan_penduduk_per_tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."laju_pertumbuhan_penduduk_per_tahun") END), ',', '.')::numeric ELSE NULL END) AS "laju_pertumbuhan_penduduk_per_tahun",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."persentase_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."persentase_penduduk") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."persentase_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."persentase_penduduk") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."persentase_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."persentase_penduduk") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."persentase_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."persentase_penduduk") END), ',', '.')::numeric ELSE NULL END) AS "persentase_penduduk",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."kepadatan_penduduk_per_km_persegi_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."kepadatan_penduduk_per_km_persegi_km2") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."kepadatan_penduduk_per_km_persegi_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."kepadatan_penduduk_per_km_persegi_km2") END)::numeric)::integer ELSE NULL END) AS "kepadatan_penduduk_per_km_persegi_km2",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."rasio_jenis_kelamin_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rasio_jenis_kelamin_penduduk") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."rasio_jenis_kelamin_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rasio_jenis_kelamin_penduduk") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."rasio_jenis_kelamin_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rasio_jenis_kelamin_penduduk") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."rasio_jenis_kelamin_penduduk")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."rasio_jenis_kelamin_penduduk") END), ',', '.')::numeric ELSE NULL END) AS "rasio_jenis_kelamin_penduduk",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tahun") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."tahun")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."tahun") END)::numeric)::integer ELSE NULL END) AS "tahun"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "provinsi",
  "jumlah_penduduk_ribu",
  "laju_pertumbuhan_penduduk_per_tahun",
  "persentase_penduduk",
  "kepadatan_penduduk_per_km_persegi_km2",
  "rasio_jenis_kelamin_penduduk",
  "tahun",
  CASE WHEN (provinsi IS NULL OR tahun IS NULL) OR (jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (provinsi IS NULL OR tahun IS NULL) OR (jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0) OR (jumlah_penduduk_ribu IS NULL) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN provinsi IS NULL OR tahun IS NULL THEN 'DQ-KEY-15'
    WHEN jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0 THEN 'DQ-DOM-16'
    WHEN jumlah_penduduk_ribu IS NULL THEN 'DQ-DOM-15'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN provinsi IS NULL OR tahun IS NULL THEN 'CRITICAL'
    WHEN jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0 THEN 'CRITICAL'
    WHEN jumlah_penduduk_ribu IS NULL THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN provinsi IS NULL OR tahun IS NULL THEN 'provinsi,tahun'
    WHEN jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0 THEN 'jumlah_penduduk_ribu'
    WHEN jumlah_penduduk_ribu IS NULL THEN 'jumlah_penduduk_ribu'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN provinsi IS NULL OR tahun IS NULL THEN (COALESCE(provinsi,'NULL') || '|' || COALESCE(tahun::text,'NULL'))::text
    WHEN jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0 THEN (jumlah_penduduk_ribu::text)::text
    WHEN jumlah_penduduk_ribu IS NULL THEN (COALESCE(provinsi,'') || ':' || COALESCE(tahun::text,''))::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN provinsi IS NULL OR tahun IS NULL THEN 'Provinsi atau tahun kependudukan kosong'
    WHEN jumlah_penduduk_ribu IS NOT NULL AND jumlah_penduduk_ribu &lt;= 0 THEN 'Jumlah penduduk &lt;= 0'
    WHEN jumlah_penduduk_ribu IS NULL THEN 'Data penduduk kosong/sentinel ''...'' (provinsi pemekaran Papua 2022-2023)'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(provinsi, 'NULL') || '|' || COALESCE(tahun::text, 'NULL'))::text AS dq_record_id,
  'raw.src_12_penduduk_provinsi'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Filter DQ Issues</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Log DQ Issues</send_true_to>
    <send_false_to>No DQ Issue</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_has_issue</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform>
    <name>Load Staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <schema>stg</schema>
    <table>src_12_penduduk_provinsi</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>_batch_id</column_name>
        <stream_name>_batch_id</stream_name>
      </field>
      <field>
        <column_name>_src_id</column_name>
        <stream_name>_src_id</stream_name>
      </field>
      <field>
        <column_name>_src_file</column_name>
        <stream_name>_src_file</stream_name>
      </field>
      <field>
        <column_name>_row_no</column_name>
        <stream_name>_row_no</stream_name>
      </field>
      <field>
        <column_name>provinsi</column_name>
        <stream_name>provinsi</stream_name>
      </field>
      <field>
        <column_name>jumlah_penduduk_ribu</column_name>
        <stream_name>jumlah_penduduk_ribu</stream_name>
      </field>
      <field>
        <column_name>laju_pertumbuhan_penduduk_per_tahun</column_name>
        <stream_name>laju_pertumbuhan_penduduk_per_tahun</stream_name>
      </field>
      <field>
        <column_name>persentase_penduduk</column_name>
        <stream_name>persentase_penduduk</stream_name>
