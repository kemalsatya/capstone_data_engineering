        <stream_name>kepadatan_penduduk_per_km_persegi_km2</stream_name>
      </field>
      <field>
        <column_name>rasio_jenis_kelamin_penduduk</column_name>
        <stream_name>rasio_jenis_kelamin_penduduk</stream_name>
      </field>
      <field>
        <column_name>tahun</column_name>
        <stream_name>tahun</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Quarantine Records</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
