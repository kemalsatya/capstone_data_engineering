<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_02_bnpb_bencana</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_02_bnpb_bencana</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_02_bnpb_bencana
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_02_bnpb_bencana r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
deduped AS (
  SELECT sub."_batch_id", sub."_src_id", sub."_src_file", sub."_row_no", sub."city_id", sub."date", sub."disaster_type", sub."city", sub."province", sub."cause", sub."death", sub."missing_person", sub."injured_person", sub."damaged_house", sub."flooded_house", sub."damaged_facility"
  FROM (
    SELECT r.*,
           ROW_NUMBER() OVER (PARTITION BY r."city_id", r."date", r."disaster_type", r."city", r."province", r."cause", r."death", r."missing_person", r."injured_person", r."damaged_house", r."flooded_house", r."damaged_facility" ORDER BY r._row_no) AS _dedup_rn
    FROM latest_raw r
  ) sub
  WHERE _dedup_rn = 1
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN LOWER(TRIM(r."city_id")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."city_id") END) AS "city_id",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}' THEN SUBSTRING((CASE WHEN LOWER(TRIM(r."date")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."date") END) FROM 1 FOR 10)::date ELSE NULL END) AS "date",
  (CASE WHEN LOWER(TRIM(r."disaster_type")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."disaster_type") END) AS "disaster_type",
  (CASE WHEN LOWER(TRIM(r."city")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."city") END) AS "city",
  (CASE WHEN LOWER(TRIM(r."province")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."province") END) AS "province",
  (CASE WHEN LOWER(TRIM(r."cause")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."cause") END) AS "cause",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."death")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."death") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."death")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."death") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."death")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."death") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."death")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."death") END), ',', '.')::numeric ELSE NULL END) AS "death",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."missing_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."missing_person") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."missing_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."missing_person") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."missing_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."missing_person") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."missing_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."missing_person") END), ',', '.')::numeric ELSE NULL END) AS "missing_person",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."injured_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."injured_person") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."injured_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."injured_person") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."injured_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."injured_person") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."injured_person")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."injured_person") END), ',', '.')::numeric ELSE NULL END) AS "injured_person",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."damaged_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_house") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."damaged_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_house") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."damaged_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_house") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."damaged_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_house") END), ',', '.')::numeric ELSE NULL END) AS "damaged_house",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."flooded_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."flooded_house") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."flooded_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."flooded_house") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."flooded_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."flooded_house") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."flooded_house")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."flooded_house") END), ',', '.')::numeric ELSE NULL END) AS "flooded_house",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."damaged_facility")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_facility") END) ~ '^[-+]?[0-9]+(?:\.0+)?$' THEN TRUNC((CASE WHEN LOWER(TRIM(r."damaged_facility")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."damaged_facility") END)::numeric)::integer ELSE NULL END) AS "damaged_facility"
FROM deduped r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "city_id",
  "date",
  "disaster_type",
  "city",
  "province",
  "cause",
  "death",
  "missing_person",
  "injured_person",
  "damaged_house",
  "flooded_house",
  "damaged_facility",
  CASE WHEN (date IS NULL OR disaster_type IS NULL) OR (COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (date IS NULL OR disaster_type IS NULL) OR (COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0) OR (COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN date IS NULL OR disaster_type IS NULL THEN 'DQ-KEY-02'
    WHEN COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0 THEN 'DQ-DOM-04'
    WHEN COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0 THEN 'DQ-DOM-03'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN date IS NULL OR disaster_type IS NULL THEN 'CRITICAL'
    WHEN COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0 THEN 'CRITICAL'
    WHEN COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0 THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN date IS NULL OR disaster_type IS NULL THEN 'date,disaster_type'
    WHEN COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0 THEN 'death,missing_person,injured_person,damaged_house,flooded_house,damaged_facility'
    WHEN COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0 THEN 'death,missing_person,injured_person,flooded_house'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN date IS NULL OR disaster_type IS NULL THEN (COALESCE(date::text,'NULL') || '|' || COALESCE(disaster_type,'NULL'))::text
    WHEN COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0 THEN (COALESCE(death::text,'0') || '/' || COALESCE(damaged_house::text,'0'))::text
    WHEN COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0 THEN (COALESCE(death::text,'0') || ',' || COALESCE(missing_person::text,'0') || ',' || COALESCE(injured_person::text,'0') || ',' || COALESCE(flooded_house::text,'0'))::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN date IS NULL OR disaster_type IS NULL THEN 'Tanggal atau jenis bencana kosong'
    WHEN COALESCE(death,0) &lt; 0 OR COALESCE(missing_person,0) &lt; 0 OR COALESCE(injured_person,0) &lt; 0 OR COALESCE(damaged_house,0) &lt; 0 OR COALESCE(flooded_house,0) &lt; 0 OR COALESCE(damaged_facility,0) &lt; 0 THEN 'Jumlah korban atau kerusakan bernilai negatif'
    WHEN COALESCE(death,0) % 1 &lt;&gt; 0 OR COALESCE(missing_person,0) % 1 &lt;&gt; 0 OR COALESCE(injured_person,0) % 1 &lt;&gt; 0 OR COALESCE(flooded_house,0) % 1 &lt;&gt; 0 THEN 'Nilai pecahan pada kolom korban/rumah terendam (dipertahankan sesuai D11)'
    ELSE NULL
  END AS dq_reason,
  (_src_file || '#' || _row_no)::text AS dq_record_id,
  'raw.src_02_bnpb_bencana'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Filter DQ Issues</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Log DQ Issues</send_true_to>
    <send_false_to>No DQ Issue</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_has_issue</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform>
    <name>Load Staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <schema>stg</schema>
    <table>src_02_bnpb_bencana</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>_batch_id</column_name>
        <stream_name>_batch_id</stream_name>
      </field>
      <field>
        <column_name>_src_id</column_name>
        <stream_name>_src_id</stream_name>
      </field>
      <field>
        <column_name>_src_file</column_name>
        <stream_name>_src_file</stream_name>
      </field>
      <field>
        <column_name>_row_no</column_name>
        <stream_name>_row_no</stream_name>
      </field>
      <field>
        <column_name>city_id</column_name>
        <stream_name>city_id</stream_name>
      </field>
      <field>
        <column_name>date</column_name>
        <stream_name>date</stream_name>
      </field>
      <field>
        <column_name>disaster_type</column_name>
        <stream_name>disaster_type</stream_name>
      </field>
      <field>
        <column_name>city</column_name>
        <stream_name>city</stream_name>
      </field>
      <field>
        <column_name>province</column_name>
        <stream_name>province</stream_name>
      </field>
      <field>
        <column_name>cause</column_name>
        <stream_name>cause</stream_name>
      </field>
      <field>
        <column_name>death</column_name>
        <stream_name>death</stream_name>
      </field>
      <field>
        <column_name>missing_person</column_name>
        <stream_name>missing_person</stream_name>
      </field>
      <field>
        <column_name>injured_person</column_name>
        <stream_name>injured_person</stream_name>
      </field>
      <field>
        <column_name>damaged_house</column_name>
        <stream_name>damaged_house</stream_name>
      </field>
      <field>
        <column_name>flooded_house</column_name>
        <stream_name>flooded_house</stream_name>
      </field>
