  (CASE WHEN (CASE WHEN LOWER(TRIM(r."road_length_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_length_km") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."road_length_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_length_km") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."road_length_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_length_km") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."road_length_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_length_km") END), ',', '.')::numeric ELSE NULL END) AS "road_length_km",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."road_density_km_per_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_density_km_per_km2") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."road_density_km_per_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_density_km_per_km2") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."road_density_km_per_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_density_km_per_km2") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."road_density_km_per_km2")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."road_density_km_per_km2") END), ',', '.')::numeric ELSE NULL END) AS "road_density_km_per_km2",
  (CASE WHEN (CASE WHEN LOWER(TRIM(r."dist_to_primary_trunk_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."dist_to_primary_trunk_km") END) ~ '^[-+]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][-+]?[0-9]+)?$' THEN (CASE WHEN LOWER(TRIM(r."dist_to_primary_trunk_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."dist_to_primary_trunk_km") END)::numeric WHEN (CASE WHEN LOWER(TRIM(r."dist_to_primary_trunk_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."dist_to_primary_trunk_km") END) ~ '^[-+]?[0-9]+,[0-9]+$' THEN REPLACE((CASE WHEN LOWER(TRIM(r."dist_to_primary_trunk_km")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."dist_to_primary_trunk_km") END), ',', '.')::numeric ELSE NULL END) AS "dist_to_primary_trunk_km",
  (CASE WHEN LOWER(TRIM(r."centroid_type")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."centroid_type") END) AS "centroid_type"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "bps_kabkota_code",
  "kabkota_name",
  "prov_name",
  "shapename",
  "crosswalk_match_type",
  "crosswalk_match_score",
  "ipm_2023",
  "ipm_2024",
  "ppm_2023",
  "ppm_2024",
  "population_2023",
  "population_2024",
  "ntl_radiance_mean",
  "ntl_no_data",
  "elevation_mean_m",
  "elevation_std_m",
  "elevation_no_data",
  "pct_tree_cover",
  "pct_shrubland",
  "pct_grassland",
  "pct_cropland",
  "pct_built_up",
  "pct_bare_sparse_veg",
  "pct_snow_ice",
  "pct_water",
  "pct_wetland",
  "pct_mangroves",
  "pct_moss_lichen",
  "landcover_no_data",
  "tertinggal_status",
  "is_tertinggal",
  "allsky_sfc_sw_dwn_mean",
  "t2m_mean",
  "ws10m_mean",
  "ws50m_mean",
  "rh2m_mean",
  "prectotcorr_mean",
  "solar_zonal_fallback",
  "weather_zonal_fallback",
  "wind_speed_100m_mean_ms",
  "wind_no_data",
  "road_length_km",
  "road_density_km_per_km2",
  "dist_to_primary_trunk_km",
  "centroid_type",
  CASE WHEN (bps_kabkota_code IS NULL OR kabkota_name IS NULL) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (bps_kabkota_code IS NULL OR kabkota_name IS NULL) OR (elevation_mean_m IS NULL) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN bps_kabkota_code IS NULL OR kabkota_name IS NULL THEN 'DQ-KEY-06'
    WHEN elevation_mean_m IS NULL THEN 'DQ-DOM-06'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN bps_kabkota_code IS NULL OR kabkota_name IS NULL THEN 'CRITICAL'
    WHEN elevation_mean_m IS NULL THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN bps_kabkota_code IS NULL OR kabkota_name IS NULL THEN 'bps_kabkota_code,kabkota_name'
    WHEN elevation_mean_m IS NULL THEN 'elevation_mean_m'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN bps_kabkota_code IS NULL OR kabkota_name IS NULL THEN (COALESCE(bps_kabkota_code,'NULL'))::text
    WHEN elevation_mean_m IS NULL THEN (elevation_mean_m::text)::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN bps_kabkota_code IS NULL OR kabkota_name IS NULL THEN 'Kode BPS atau nama kab/kota kosong'
    WHEN elevation_mean_m IS NULL THEN 'Nilai elevation_mean_m kosong'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(bps_kabkota_code, _row_no::text))::text AS dq_record_id,
  'raw.src_04_fitur_kabkota'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
