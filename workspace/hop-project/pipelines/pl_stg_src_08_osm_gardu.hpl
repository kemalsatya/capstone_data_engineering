  "start_date",
  "substation",
  "type",
  "utility",
  "voltage",
  "geometry",
  "longitude",
  "latitude",
  "geometry_wkt",
  CASE WHEN (id IS NULL) OR (latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (id IS NULL) OR (latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5) OR (voltage IS NULL) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN id IS NULL THEN 'DQ-KEY-10'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5 THEN 'DQ-GEO-01-LAND'
    WHEN voltage IS NULL THEN 'DQ-DOM-10'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN id IS NULL THEN 'CRITICAL'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5 THEN 'CRITICAL'
    WHEN voltage IS NULL THEN 'WARNING'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN id IS NULL THEN 'id'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5 THEN 'latitude,longitude'
    WHEN voltage IS NULL THEN 'voltage'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN id IS NULL THEN (id)::text
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5 THEN (COALESCE(latitude::text,'NULL') || ',' || COALESCE(longitude::text,'NULL'))::text
    WHEN voltage IS NULL THEN (voltage)::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN id IS NULL THEN 'ID elemen OSM kosong'
    WHEN latitude IS NULL OR longitude IS NULL OR latitude NOT BETWEEN -11.5 AND 6.5 OR longitude NOT BETWEEN 94.5 AND 141.5 THEN 'Koordinat gardu OSM di luar BBox daratan Indonesia'
    WHEN voltage IS NULL THEN 'Tag tegangan (voltage) tidak terisi pada elemen OSM'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(id, _row_no::text))::text AS dq_record_id,
  'raw.src_08_osm_gardu'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
