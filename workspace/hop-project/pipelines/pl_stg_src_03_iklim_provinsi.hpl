<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stg_src_03_iklim_provinsi</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Staging &amp; DQ pipeline untuk src_03_iklim_provinsi</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>generate_hop_assets</created_user>
    <created_date>2026/11/19 00:00:00.000</created_date>
    <modified_user>generate_hop_assets</modified_user>
    <modified_date>2026/11/19 00:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop><from>Read &amp; Validate Raw</from><to>Filter Critical DQ</to><enabled>Y</enabled></hop>
    <hop><from>Read &amp; Validate Raw</from><to>Filter DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Quarantine Records</to><enabled>Y</enabled></hop>
    <hop><from>Filter Critical DQ</from><to>Load Staging</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>Log DQ Issues</to><enabled>Y</enabled></hop>
    <hop><from>Filter DQ Issues</from><to>No DQ Issue</to><enabled>Y</enabled></hop>
  </order>
  <transform>
    <name>Read &amp; Validate Raw</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>WITH
latest_batches AS (
  SELECT _src_file, MAX(_batch_id) AS max_batch_id
  FROM raw.src_03_iklim_provinsi
  GROUP BY _src_file
),
latest_raw AS (
  SELECT r.*
  FROM raw.src_03_iklim_provinsi r
  JOIN latest_batches lb
    ON r._src_file = lb._src_file
   AND r._batch_id = lb.max_batch_id
),
typed AS (
SELECT
  r._batch_id,
  r._src_id,
  r._src_file,
  r._row_no,
  to_jsonb(r)::text AS dq_payload_raw,
  (CASE WHEN LOWER(TRIM(r."province_id")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."province_id") END) AS "province_id",
  (CASE WHEN LOWER(TRIM(r."province_name")) IN ('', '-', '--', '–', '...', '…', 'null', 'none', 'nan', 'na', 'n/a', '#n/a', 'n.a', 'n.a.') THEN NULL ELSE TRIM(r."province_name") END) AS "province_name"
FROM latest_raw r
)
SELECT
  _batch_id,
  _src_id,
  _src_file,
  _row_no,
  "province_id",
  "province_name",
  CASE WHEN (province_id IS NULL OR province_name IS NULL) THEN 'Y' ELSE 'N' END AS dq_is_critical,
  CASE WHEN (province_id IS NULL OR province_name IS NULL) THEN 'Y' ELSE 'N' END AS dq_has_issue,
  CASE
    WHEN province_id IS NULL OR province_name IS NULL THEN 'DQ-KEY-04'
    ELSE NULL
  END AS dq_rule_id,
  CASE
    WHEN province_id IS NULL OR province_name IS NULL THEN 'CRITICAL'
    ELSE NULL
  END AS dq_severity,
  CASE
    WHEN province_id IS NULL OR province_name IS NULL THEN 'province_id,province_name'
    ELSE NULL
  END AS dq_failed_column,
  CASE
    WHEN province_id IS NULL OR province_name IS NULL THEN (COALESCE(province_id,'NULL'))::text
    ELSE NULL
  END AS dq_failed_value,
  CASE
    WHEN province_id IS NULL OR province_name IS NULL THEN 'province_id atau province_name kosong'
    ELSE NULL
  END AS dq_reason,
  (COALESCE(province_id, _row_no::text))::text AS dq_record_id,
  'raw.src_03_iklim_provinsi'::text AS dq_source_table,
  dq_payload_raw
FROM typed;</sql>
    <variables_active>Y</variables_active>
    <attributes/>
    <GUI><xloc>120</xloc><yloc>200</yloc></GUI>
  </transform>
  <transform>
    <name>Filter Critical DQ</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Quarantine Records</send_true_to>
    <send_false_to>Load Staging</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_is_critical</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>120</yloc></GUI>
  </transform>
  <transform>
    <name>Filter DQ Issues</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Log DQ Issues</send_true_to>
    <send_false_to>No DQ Issue</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>dq_has_issue</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Y</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
    <attributes/>
    <GUI><xloc>360</xloc><yloc>300</yloc></GUI>
  </transform>
  <transform>
    <name>Load Staging</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <schema>stg</schema>
    <table>src_03_iklim_provinsi</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field>
        <column_name>_batch_id</column_name>
        <stream_name>_batch_id</stream_name>
      </field>
      <field>
        <column_name>_src_id</column_name>
        <stream_name>_src_id</stream_name>
      </field>
      <field>
        <column_name>_src_file</column_name>
        <stream_name>_src_file</stream_name>
      </field>
      <field>
        <column_name>_row_no</column_name>
        <stream_name>_row_no</stream_name>
      </field>
      <field>
        <column_name>province_id</column_name>
        <stream_name>province_id</stream_name>
      </field>
      <field>
        <column_name>province_name</column_name>
        <stream_name>province_name</stream_name>
      </field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Quarantine Records</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <schema>dq</schema>
    <table>quarantine_records</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>run_id</column_name><stream_name>_batch_id</stream_name></field>
      <field><column_name>source_table</column_name><stream_name>dq_source_table</stream_name></field>
      <field><column_name>record_id</column_name><stream_name>dq_record_id</stream_name></field>
      <field><column_name>rule_id</column_name><stream_name>dq_rule_id</stream_name></field>
      <field><column_name>failed_column</column_name><stream_name>dq_failed_column</stream_name></field>
      <field><column_name>failed_value</column_name><stream_name>dq_failed_value</stream_name></field>
      <field><column_name>reason</column_name><stream_name>dq_reason</stream_name></field>
      <field><column_name>payload_raw</column_name><stream_name>dq_payload_raw</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>60</yloc></GUI>
  </transform>
  <transform>
    <name>Log DQ Issues</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>lab-postgres</connection>
    <schema>dq</schema>
    <table>capstone_quality_issues</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields>
      <field><column_name>run_id</column_name><stream_name>_batch_id</stream_name></field>
      <field><column_name>rule_id</column_name><stream_name>dq_rule_id</stream_name></field>
      <field><column_name>source_table</column_name><stream_name>dq_source_table</stream_name></field>
      <field><column_name>record_id</column_name><stream_name>dq_record_id</stream_name></field>
      <field><column_name>severity</column_name><stream_name>dq_severity</stream_name></field>
      <field><column_name>reason</column_name><stream_name>dq_reason</stream_name></field>
    </fields>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>260</yloc></GUI>
  </transform>
  <transform>
    <name>No DQ Issue</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
    <GUI><xloc>640</xloc><yloc>360</yloc></GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
