      <type>SQL</type>
      <sql>DELETE FROM stg.src_01_bmkg_gempa WHERE _batch_id IN (SELECT MAX(_batch_id) FROM raw.src_01_bmkg_gempa GROUP BY _src_file);
DELETE FROM dq.quarantine_records WHERE source_table = 'raw.src_01_bmkg_gempa' AND run_id IN (SELECT MAX(_batch_id) FROM raw.src_01_bmkg_gempa GROUP BY _src_file);
DELETE FROM dq.capstone_quality_issues WHERE source_table IN ('raw.src_01_bmkg_gempa', 'stg.src_01_bmkg_gempa') AND run_id IN (SELECT MAX(_batch_id) FROM raw.src_01_bmkg_gempa GROUP BY _src_file);</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>lab-postgres</connection>
      <parallel>N</parallel>
      <xloc>260</xloc>
      <yloc>80</yloc>
