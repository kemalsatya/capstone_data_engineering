<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_vault_bv_master</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Master workflow Data Vault 2.0: Raw Vault (vault.*) -> Business Vault Spasial (bv.*)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>capstone</created_user>
  <created_date>2026/11/19 00:00:00.000</created_date>
  <modified_user>capstone</modified_user>
  <modified_date>2026/11/19 00:00:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>120</yloc>
    </action>
    <action>
      <name>Run wf_vault_load</name>
      <type>WORKFLOW</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/workflows/wf_vault_load.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>280</xloc>
      <yloc>120</yloc>
    </action>
    <action>
      <name>Run wf_bv_load</name>
      <type>WORKFLOW</type>
      <run_configuration>local</run_configuration>
      <filename>${PROJECT_HOME}/workflows/wf_bv_load.hwf</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Nothing</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <set_append_logfile>N</set_append_logfile>
      <parallel>N</parallel>
      <xloc>500</xloc>
      <yloc>120</yloc>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>700</xloc>
      <yloc>120</yloc>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Run wf_vault_load</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Run wf_vault_load</from><to>Run wf_bv_load</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
    <hop><from>Run wf_bv_load</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>