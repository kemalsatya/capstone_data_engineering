<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_vault_load</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Orkestrasi pemuatan Insert-Only Raw Data Vault 2.0 (vault.*)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>capstone</created_user>
  <created_date>2026/11/19 00:00:00.000</created_date>
  <modified_user>capstone</modified_user>
  <modified_date>2026/11/19 00:00:00.000</modified_date>
  <parameters/>
  <actions>
    <action>
      <name>Start</name>
      <type>SPECIAL</type>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>100</xloc>
      <yloc>120</yloc>
    </action>
    <action>
      <name>Load Raw Data Vault</name>
      <type>SQL</type>
      <sql/>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>${PROJECT_HOME}/sql/load_vault.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>lab-postgres</connection>
      <parallel>N</parallel>
      <xloc>320</xloc>
      <yloc>120</yloc>
    </action>
    <action>
      <name>Success</name>
      <type>SUCCESS</type>
      <parallel>N</parallel>
      <xloc>540</xloc>
      <yloc>120</yloc>
    </action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Load Raw Data Vault</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Load Raw Data Vault</from><to>Success</to><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>