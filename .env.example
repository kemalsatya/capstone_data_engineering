# --- Kredensial sumber data untuk workspace/python/ingestion/api_ingest.py ---
# Tidak dihasilkan otomatis oleh `init`; isi manual, lalu jangan commit (sudah ada di .gitignore).
# Kaggle: buat token di Account -> Settings -> API -> "Generate New Token".
# Token modern (KGAT_...) cukup sendiri; username TIDAK diperlukan karena diambil dari server.
KAGGLE_API_TOKEN=
# Alias legacy (opsional): hanya bila memakai API key 32-hex lama, bukan token KGAT_.
# Token KGAT_ di KAGGLE_KEY akan ditolak oleh pustaka kaggle-cli.
KAGGLE_USERNAME=
KAGGLE_KEY=
# OpenCelliD: minta token di https://opencellid.org (kuota harian terbatas). Dipakai SRC-05.
OPENCELLID_TOKEN=
# BPS WebAPI: daftarkan aplikasi di https://webapi.bps.go.id/developer/ (maks 3 aplikasi).
# Token bersifat rahasia dan dilarang dibagikan/di-commit (Ketentuan Penggunaan BPS §3).
# Kosongkan bila belum punya; SRC-10 & SRC-12 akan memakai berkas CSV yang diunduh manual.
BPS_API_KEY=
# SRC-12 (SIMDASI) juga butuh id_tabel & wilayah; salin dari tombol JSON pada tabel BPS.
BPS_PENDUDUK_ID_TABEL=
BPS_PENDUDUK_WILAYAH=
# Opsional: endpoint Overpass mirror untuk SRC-08 bila server publik sedang rate-limit.
OVERPASS_URL=https://overpass-api.de/api/interpreter

